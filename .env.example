# Spotify API Configuration
# Get these credentials from: https://developer.spotify.com/dashboard

# Your Spotify Client ID (REQUIRED)
SPOTIFY_CLIENT_ID=your_client_id_here

# Your Spotify Client Secret (OPTIONAL - not used in PKCE flow, but kept for compatibility)
SPOTIFY_CLIENT_SECRET=your_client_secret_here

# Redirect URI (must match what you set in Spotify Dashboard)
# For local development:
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/auth/spotify/callback

# For production, update to your domain:
# SPOTIFY_REDIRECT_URI=https://yourdomain.com/api/auth/spotify/callback

# NOTE: We now use PKCE (Proof Key for Code Exchange) flow
# This is more secure and follows Spotify's official documentation
# Client Secret is no longer required for authentication
